<Page x:Class="MyProject.Pages.AppointmentInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MyProject.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AppointmentInfoPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Column="1" Text="Запись" VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="20"/>
        <StackPanel Grid.Column="1" Grid.Row="1">
            <TextBlock x:Name="AppointmentNameTextBlock"/>
            <TextBlock x:Name="MasterTextBlock"/>
            <TextBlock x:Name="DateTimeTextBlock"/>
            <TextBlock Text="Выберите способ оплаты"/>
            <ComboBox x:Name="PaymentMethodCombobox" Height="19">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock x:Name="ComTB" Text="Комментарий"/>
            <TextBox x:Name="FeedbackTextBox" Height="54"/>
            
            <Button Content="Записаться" HorizontalAlignment="Center" Click="AppointButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
