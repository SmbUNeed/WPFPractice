<Page x:Class="MyProject.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MyProject.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="90,0,0,0">
            <ComboBox x:Name="FilterComboBox" Width="100" FontSize="16" Margin="5" 
                      SelectionChanged="FilterComboBox_SelectionChanged">
                <ComboBoxItem Content="По мастеру" />
                <ComboBoxItem Content="По услуге"/>
            </ComboBox>
            <TextBox x:Name="SearchTextBox" Width="300" Margin="5" TextChanged="SearchTextBox_TextChanged"/>
            <Button x:Name="AccountButton" Width="70" Margin="5"/>
            <Button Width="70" Margin="5" Content="Товары" Click="ProductsButton_Click"/>
        </StackPanel>
        <ListBox Grid.Row="1" x:Name="ListBoxMasters" SelectionChanged="ListBoxMasters_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{Binding Key.Fullname}" VerticalAlignment="Center" FontSize="16" Width="300"/>
                        <ListView ItemsSource="{Binding Value}" IsEnabled="False">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ListBox Grid.Row="1" x:Name="ListBoxServices" Visibility="Hidden" SelectionChanged="ListBoxServices_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
