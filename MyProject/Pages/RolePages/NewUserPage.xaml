<Page x:Class="MyProject.Pages.RolePages.NewUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MyProject.Pages.RolePages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="NewUserPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="0.7*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Column="1" Text="Новый пользователь" VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="20"/>
        <StackPanel Grid.Column="1" Grid.Row="1" Width="200">
            <TextBlock Text="Имя"/>
            <TextBox x:Name="NameBox"/>
            <TextBlock Text="Электронная почта"/>
            <TextBox x:Name="EmailBox"/>
            <TextBlock Text="Номер телефона"/>
            <TextBox x:Name="PhoneNumberBox"/>
            <TextBlock Text="Логин"/>
            <TextBox x:Name="LoginBox"/>
            <TextBlock Text="Пароль"/>
            <TextBox x:Name="PasswordBox"/>
            <TextBlock Text="Повторный пароль"/>
            <TextBox x:Name="RepeatPasswordBox"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Роль:" Width="50"/>
                <ComboBox x:Name="RolesCombobox" Width="100" Height="18">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <Button Content="Зарегистрировать" HorizontalAlignment="Center" Click="RegisterButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
