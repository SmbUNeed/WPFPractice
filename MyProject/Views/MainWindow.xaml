<Window x:Class="MyProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyProject"
        xmlns:vm="clr-namespace:MyProject.ViewModels"
        xmlns:core="clr-namespace:MyProject.Core_"
        xmlns:views="clr-namespace:MyProject.Views"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        Title="Читай, Пиши и не спиши. ®" Height="450" Width="800">
    <Window.DataContext>
        <core:ApplicationViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReadViewModel}">
            <views:ReadView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegisterViewModel}">
            <views:RegisterView/>
        </DataTemplate>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Читай, Пиши и не спиши" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" Cursor="Hand">
            <TextBlock.InputBindings>
                <MouseBinding MouseAction="LeftClick"
                              Command="{Binding NavigateCommand}"/>
            </TextBlock.InputBindings>
        </TextBlock>

        <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
    </Grid>
</Window>
