<UserControl x:Class="MyProject.Views.ProfileView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="20">

            <TextBlock Text="Профиль" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Имя:"    Foreground="Gray"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Логин:"  Foreground="Gray" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Login}" Margin="0,6,0,0"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Email:"  Foreground="Gray" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Email}" Margin="0,6,0,0"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Роль:"   Foreground="Gray" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Role}"  Margin="0,6,0,0"/>
            </Grid>

            <Border Visibility="{Binding IsFrozen, Converter={StaticResource BoolToVis}}"
                    Background="#FFF3CD" BorderBrush="#FFC107"
                    BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="⚠ Ваш аккаунт заморожен" FontWeight="Bold" Foreground="#856404"/>
                    <TextBlock Text="{Binding FreezeReason}" Foreground="#856404" Margin="0,4,0,10" TextWrapping="Wrap"/>

                    <StackPanel Visibility="{Binding CanAppeal, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Оспорить заморозку:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding AppealComment, UpdateSourceTrigger=PropertyChanged}"
                                 Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                 Margin="0,0,0,6"/>
                        <Button Content="Отправить заявку"
                                Command="{Binding SubmitAppealCommand}"
                                HorizontalAlignment="Left" Padding="10,4"/>
                    </StackPanel>

                    <TextBlock Visibility="{Binding HasPendingAppeal, Converter={StaticResource BoolToVis}}"
                               Text="✓ Заявка на оспаривание уже отправлена"
                               Foreground="#856404" FontStyle="Italic"/>
                </StackPanel>
            </Border>

            <GroupBox Visibility="{Binding CanRequestAuthor, Converter={StaticResource BoolToVis}}"
                      Header="Стать автором" Margin="0,0,0,15">
                <StackPanel Margin="8">
                    <TextBlock Text="Расскажите о себе и своих планах:" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding AuthorComment, UpdateSourceTrigger=PropertyChanged}"
                             Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,6"/>
                    <Button Content="Подать заявку"
                            Command="{Binding SubmitAuthorRequestCommand}"
                            HorizontalAlignment="Left" Padding="10,4"/>
                </StackPanel>
            </GroupBox>

            <TextBlock Visibility="{Binding HasPendingAuthorRequest, Converter={StaticResource BoolToVis}}"
                       Text="✓ Заявка на роль Автора уже отправлена. Ожидайте решения."
                       Foreground="Gray" FontStyle="Italic" Margin="0,0,0,15"/>

            <TextBlock Text="Мои отзывы" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <ItemsControl ItemsSource="{Binding Reviews}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="8" Margin="0,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Books.Name}" FontWeight="Bold" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Rate}" Foreground="Orange"/>
                                    <TextBlock Text="/10" Foreground="Gray"/>
                                    <TextBlock Text="{Binding CreationDate, StringFormat=dd.MM.yyyy}"
                                               Foreground="Gray" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding Text}" TextWrapping="Wrap" Foreground="#444"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>