<UserControl x:Class="MyProject.Views.HomeView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:views="clr-namespace:MyProject.Views"
      xmlns:vm="clr-namespace:MyProject.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <DataTemplate DataType="{x:Type vm:AdminViewModel}">
            <views:AdminView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuthorViewModel}">
            <views:AuthorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BookListsViewModel}">
            <views:BookListsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CatalogViewModel}">
            <views:CatalogView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
            <views:ProfileView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BookViewModel}">
            <views:BookView/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Border BorderThickness="1" BorderBrush="Black" Grid.Row="1" Grid.Column="0">
            <Grid>
                <StackPanel Margin="10">
                    <Button Command="{Binding OpenCatalogCommand}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/catalog.png" Height="20" Width="20"/>
                            <TextBlock Text="  Каталог"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenReadListsCommand}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/readlists.png" Height="20" Width="20"/>
                            <TextBlock Text="  Списки книг"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenAdminCommand}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/administration.png" Height="20" Width="20"/>
                            <TextBlock Text="  Администрирование"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenAuthorCommand}" Visibility="{Binding IsAuthor, Converter={StaticResource BoolToVis}}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/author.png" Height="20" Width="20"/>
                            <TextBlock Text="  Автор"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Ваш аккаунт заморожен" Foreground="Red" Visibility="{Binding IsFrozen, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <Button VerticalAlignment="Bottom" 
                        HorizontalContentAlignment="Left" 
                        Height="50" 
                        Margin="10" 
                        BorderThickness="0" 
                        Background="Transparent" 
                        Command="{Binding OpenProfileCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/profile.png" Margin="10"/>
                        <TextBlock Margin="10" Text="Профиль" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        
        <ContentControl Grid.Column="1" Grid.Row="1" Content="{Binding CurrentContent}"/>
    </Grid>
</UserControl>
