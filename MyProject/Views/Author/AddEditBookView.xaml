<UserControl x:Class="MyProject.Views.AddEditBookView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Text="Название книги:"/>
            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,4,0,12"/>

            <TextBlock Text="Обложка:"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                <Image Source="{Binding CoverPath}" Width="80" Height="110"
                       Stretch="UniformToFill" Margin="0,0,10,0"/>
                <Button Content="Выбрать файл"
                        Command="{Binding BrowseCoverCommand}"
                        VerticalAlignment="Bottom" Padding="10,4"/>
            </StackPanel>

            <TextBlock Text="Жанры:" Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding Genres}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Genre.Name}"
                                  IsChecked="{Binding IsSelected}"
                                  Margin="0,0,12,4"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Margin="0,15,0,6">
                <TextBlock Text="Главы:" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="+ Добавить главу"
                        Command="{Binding AddChapterCommand}"
                        Margin="12,0,0,0" Padding="8,3"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Chapters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="1"
                                CornerRadius="3" Margin="0,4" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Number, StringFormat='#{0}'}"
                                           VerticalAlignment="Center" Foreground="Gray"/>

                                <TextBox Grid.Column="1"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="6,0" VerticalAlignment="Center"/>

                                <Button Grid.Column="2"
                                        Content="{Binding FileName}"
                                        Command="{Binding BrowseCommand}"
                                        Padding="6,3" Margin="0,0,6,0"
                                        MaxWidth="180" ToolTip="{Binding FilePath}"/>

                                <Button Grid.Column="3" Content="✕"
                                        Command="{Binding DataContext.RemoveChapterCommand,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Foreground="Red" Background="Transparent"
                                        BorderThickness="0" Padding="4"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="Сохранить"
                        Command="{Binding SaveCommand}"
                        Padding="16,6" Margin="0,0,10,0"/>
                <Button Content="Отмена"
                        Command="{Binding CancelCommand}"
                        Padding="16,6"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>