<UserControl x:Class="MyProject.Views.AuthorView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:views="clr-namespace:MyProject.Views"
      xmlns:vm="clr-namespace:MyProject.ViewModels"
      mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:AuthorBooksViewModel}">
            <views:AuthorBooksView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AddEditBookViewModel}">
            <views:AddEditBookView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FrozenAuthorBooksViewModel}">
            <views:FrozenAuthorBooksView/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,5">
            <Button Content="Мои книги"       Command="{Binding OpenBooksCommand}"   Margin="0,0,8,0" Padding="12,4"/>
            <Button Content="Добавить книгу"  Command="{Binding OpenAddBookCommand}" Margin="0,0,8,0" Padding="12,4"/>
            <Button Content="Замороженные"    Command="{Binding OpenFrozenCommand}"  Padding="12,4"/>
        </StackPanel>

        <ContentControl Grid.Row="1" Content="{Binding CurrentTab}"/>
    </Grid>
</UserControl>