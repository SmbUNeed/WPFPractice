<Window x:Class="MyProject.Windows.FilterModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyProject.Windows"
        mc:Ignorable="d"
        Title="Фильтры" Height="150" Width="200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Text="Производитель" Margin="5"/>
            <ComboBox x:Name="ManufacturersComboBox" Height="28" Margin="5">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <TextBlock Text="Тип товара" Margin="5"/>
            <ComboBox x:Name="ProductTypesComboBox" Height="28" Margin="5">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        <Button Content="Сбросить" Height="30" Width="90" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="5" Click="RestoreFilters"/>
        <Button Grid.Column="2" Content="Применить" Height="30" Width="90" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="5" Click="ApplyFilters"/>
    </Grid>
</Window>
