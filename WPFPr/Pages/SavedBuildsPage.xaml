<Page x:Class="BuilderPC.Pages.SavedBuildsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Сохранённые сборки">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Сохранённые сборки" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Обновить"
                    Style="{StaticResource ActionButton}"
                    Click="BtnRefresh_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Список сборок -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="BuildsList"
                         SelectionChanged="BuildsList_SelectionChanged"
                         BorderThickness="1" BorderBrush="#DDD">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="4,4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Foreground="#777" FontSize="11">
                                    <Run Text="Автор: "/>
                                    <Run Text="{Binding Author}"/>
                                </TextBlock>
                                <TextBlock Foreground="#1A73E8" FontSize="12"
                                           Text="{Binding TotalPriceDisplay}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="1" Content="Удалить выбранную"
                        Style="{StaticResource DangerButton}"
                        Margin="0,6,0,0"
                        Click="BtnDelete_Click"/>
            </Grid>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="#E0E0E0"/>

            <!-- Детали сборки -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок деталей -->
                <StackPanel Grid.Row="0" Margin="8,0,0,8">
                    <TextBlock x:Name="TxtBuildTitle" Text="Выберите сборку"
                               FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtBuildAuthor" Foreground="#555" FontSize="12"/>
                </StackPanel>

                <!-- Список компонентов сборки -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Margin="8,0,0,0">
                    <ItemsControl x:Name="PartsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EEE" BorderThickness="0,0,0,1"
                                        Padding="4,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding PartTypeName}"
                                                   Foreground="#666"
                                                   FontSize="12"
                                                   VerticalAlignment="Top"
                                                   TextWrapping="Wrap"/>

                                        <StackPanel Grid.Column="1" Margin="8,0">
                                            <TextBlock Text="{Binding Name}"
                                                       TextWrapping="Wrap"
                                                       FontSize="13"/>
                                            <TextBlock Text="{Binding Manufacturer}"
                                                       Foreground="#888"
                                                       FontSize="11"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PriceDisplay}"
                                                   Foreground="#1A73E8"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Итоговая сумма -->
                <Border Grid.Row="2" Background="#F8F9FA" CornerRadius="6"
                        Padding="12,8" Margin="8,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Итого:" FontWeight="SemiBold" FontSize="14"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtDetailTotal" Grid.Column="1"
                                   Text="—" FontSize="18" FontWeight="Bold"
                                   Foreground="#1A73E8"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
