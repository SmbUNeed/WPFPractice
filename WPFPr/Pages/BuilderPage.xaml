<Page x:Class="BuilderPC.Pages.BuilderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Сборщик ПК">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="400"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="1.2*" MinWidth="220"/>
        </Grid.ColumnDefinitions>

        <!-- ══ ЛЕВАЯ ЧАСТЬ: Список компонентов сборки ══ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Конфигурация" FontSize="16"
                       FontWeight="SemiBold" Margin="0,0,0,8"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ComponentsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Строка компонента -->
                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                                    Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" MinWidth="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Тип компонента -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding TypeName}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Top"
                                               TextWrapping="Wrap"
                                               Foreground="#555"/>

                                    <!-- Название и характеристики -->
                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock Text="{Binding PartName}"
                                                   TextWrapping="Wrap"
                                                   FontSize="13"/>
                                        <TextBlock Text="{Binding Specs}"
                                                   TextWrapping="Wrap"
                                                   Foreground="#777"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Цена -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Price}"
                                               Foreground="#1A73E8"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="8,0"/>

                                    <!-- Кнопки -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="Сменить"
                                                Tag="{Binding TypeId}"
                                                Style="{StaticResource ActionButton}"
                                                FontSize="12"
                                                Click="BtnSelectPart_Click"
                                                Margin="0,0,4,0"/>
                                        <Button Content="✕"
                                                Tag="{Binding TypeId}"
                                                Style="{StaticResource DangerButton}"
                                                FontSize="12" Padding="8,6"
                                                Click="BtnRemovePart_Click"
                                                Visibility="{Binding RemoveVisible}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                      Background="#E0E0E0"/>

        <!-- ══ ПРАВАЯ ЧАСТЬ: Итог и предупреждения ══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Итоговая стоимость -->
            <Border Grid.Row="0" Background="#F8F9FA" CornerRadius="6"
                    Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Итого" FontSize="14" Foreground="#555"/>
                    <TextBlock x:Name="TxtTotalPrice"
                               Text="0 ₽"
                               FontSize="24" FontWeight="Bold"
                               Foreground="#1A73E8"/>
                    <TextBlock x:Name="TxtPartsCount"
                               Text="Компонентов: 0"
                               FontSize="12" Foreground="#777"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Предупреждения о совместимости -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Совместимость" FontWeight="SemiBold"
                               FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtCompatOk"
                               Text="✓ Нет проблем с совместимостью"
                               Foreground="Green" FontSize="12"
                               TextWrapping="Wrap"/>
                    <ItemsControl x:Name="WarningsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFF3CD" CornerRadius="4"
                                        Padding="8,6" Margin="0,3">
                                    <TextBlock Text="{Binding}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="#856404"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Кнопки действий -->
            <StackPanel Grid.Row="2">
                <Button Content="Сохранить сборку"
                        Style="{StaticResource SuccessButton}"
                        FontSize="14" Padding="12,10"
                        Click="BtnSave_Click"
                        Margin="0,0,0,6"/>
                <Button Content="Очистить сборку"
                        Style="{StaticResource DangerButton}"
                        FontSize="13"
                        Click="BtnClear_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
