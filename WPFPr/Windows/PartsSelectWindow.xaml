<Window x:Class="BuilderPC.Windows.PartsSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор комплектующего"
        MinWidth="700" MinHeight="500"
        Width="860" Height="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   x:Name="TxtTitle"
                   Text="Выбор компонента"
                   FontSize="16" FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <!-- Строка поиска и фильтра -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtSearch"
                     Grid.Column="0"
                     Height="32"
                     Padding="8,6"
                     FontSize="13"
                     VerticalContentAlignment="Center"
                     TextChanged="TxtSearch_TextChanged">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                    <Border BorderBrush="#CCC" BorderThickness="1"
                                            CornerRadius="4" Background="White">
                                        <Grid>
                                            <TextBlock x:Name="Placeholder"
                                                       Text="Поиск по названию..."
                                                       Foreground="#999"
                                                       Padding="9,7"
                                                       IsHitTestVisible="False"/>
                                            <ScrollViewer x:Name="PART_ContentHost"
                                                          Padding="8,6"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Text" Value=""/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <ComboBox x:Name="CmbManufacturer"
                      Grid.Column="2"
                      Height="32"
                      FontSize="13"
                      VerticalContentAlignment="Center"
                      SelectionChanged="CmbManufacturer_SelectionChanged"/>

            <Button Grid.Column="4" Content="Найти"
                    Style="{StaticResource ActionButton}"
                    Height="32"
                    Click="BtnSearch_Click"/>
        </Grid>

        <!-- Таблица комплектующих -->
        <DataGrid x:Name="PartsGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  BorderThickness="1"
                  BorderBrush="#DDD"
                  RowBackground="White"
                  AlternatingRowBackground="#FAFAFA"
                  CanUserResizeRows="False"
                  MouseDoubleClick="PartsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}"
                                    Width="2*" MinWidth="140"/>
                <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}"
                                    Width="120"/>
                <DataGridTextColumn Header="Характеристики" Binding="{Binding SpecsSummary}"
                                    Width="3*" MinWidth="200">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding" Value="4,2"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Цена" Binding="{Binding PriceDisplay}"
                                    Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#1A73E8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,8,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Нижняя панель -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtFoundCount" Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="#666" FontSize="12"/>

            <Button Grid.Column="1" Content="Выбрать"
                    Style="{StaticResource SuccessButton}"
                    FontSize="14" Padding="20,8"
                    Click="BtnConfirm_Click"/>

            <Button Grid.Column="3" Content="Отмена"
                    Padding="16,8" FontSize="14"
                    Click="BtnCancel_Click"/>
        </Grid>
    </Grid>
</Window>
