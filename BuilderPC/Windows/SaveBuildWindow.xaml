<Window x:Class="BuilderPC.Windows.SaveBuildWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сохранить сборку"
        Width="360" Height="200"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="16">
        <TextBlock Text="Название сборки:" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtName" Margin="0,0,0,10" MaxLength="255"/>

        <TextBlock Text="Имя автора:" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtAuthor" Margin="0,0,0,6" MaxLength="255"/>

        <TextBlock x:Name="TxtError" Foreground="Red" Visibility="Collapsed" Margin="0,0,0,6"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Click="BtnCancel_Click" Width="80" Margin="0,0,8,0"/>
            <Button Content="Сохранить" Click="BtnSave_Click" Width="90"/>
        </StackPanel>
    </StackPanel>
</Window>
