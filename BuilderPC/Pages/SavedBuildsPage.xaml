<Page x:Class="BuilderPC.Pages.SavedBuildsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Сохранённые сборки">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Список сборок -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                <TextBlock Text="Сборки" FontWeight="Bold" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <Button Content="Обновить" Click="BtnRefresh_Click"/>
            </StackPanel>

            <ListBox x:Name="LstAssemblies"
                     SelectionChanged="LstAssemblies_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <TextBlock Text="{Binding name}" FontWeight="SemiBold"/>
                            <TextBlock>
                                <Run Text="Автор: "/>
                                <Run Text="{Binding author}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Детали сборки -->
        <Grid Grid.Column="1">
            <TextBlock x:Name="TxtHint" Text="Выберите сборку из списка"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="Gray"/>

            <DockPanel x:Name="PnlDetail" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top" Margin="8,6,8,6">
                    <TextBlock x:Name="TxtName" FontSize="15" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtAuthor" Foreground="Gray"/>
                    <TextBlock x:Name="TxtTotal" FontWeight="Bold"/>
                </StackPanel>

                <DataGrid x:Name="DgParts"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Тип"      Width="160"
                                            Binding="{Binding parttype_.name}"/>
                        <DataGridTextColumn Header="Название" Width="*"
                                            Binding="{Binding name}"/>
                        <DataGridTextColumn Header="Цена, руб." Width="110"
                                            Binding="{Binding price}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </Grid>
</Page>
