<Window x:Class="WPFMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFMaster"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Cursor="Hand" Text="Absolute Cinema" Height="40" Width="300" TextAlignment="Center" FontSize="30" MouseDown="TextBlock_MouseDown" />

        <Button Width="40" Height="40" HorizontalAlignment="Left" Margin="10" Click="Button_Click" Background="Transparent" BorderBrush="Transparent" Focusable="False" Cursor="Hand" VerticalAlignment="Top">
            <Image Source="/Images/profile.png"/>
        </Button>
        <Frame x:Name="Frame" NavigationUIVisibility="Hidden" Source="/Pages/MainPage.xaml" Grid.Row="1"/>
    </Grid>
</Window>
