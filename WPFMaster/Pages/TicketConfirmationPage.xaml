<Page x:Class="WPFMaster.Pages.TicketConfirmationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFMaster.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TicketConfirmationPage">

    <Grid>
        <StackPanel Margin="20">

            <TextBlock Text="Оформление билета" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

            <!-- Информация о сеансе -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Фильм:"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtFilm" FontWeight="SemiBold"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Зал:" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtHall" Margin="0,6,0,0"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата и время:" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtDateTime" Margin="0,6,0,0"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Цена за место:" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtPrice" Margin="0,6,0,0"/>
            </Grid>

            <Separator Margin="0,10"/>

            <!-- Список выбранных мест -->
            <TextBlock Text="Выбранные места:" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ItemsControl x:Name="SeatsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Margin="0,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator Margin="0,10"/>

            <!-- Итого -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="Итого: " FontWeight="Bold" FontSize="15"/>
                <TextBlock x:Name="TxtTotal" FontWeight="Bold" FontSize="15"/>
            </StackPanel>

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnConfirm" Content="Подтвердить" Width="130" Click="BtnConfirm_Click"/>
                <Button Content="Назад" Width="80" Margin="10,0,0,0" Click="BtnBack_Click"/>
            </StackPanel>

        </StackPanel>

    </Grid>
</Page>
