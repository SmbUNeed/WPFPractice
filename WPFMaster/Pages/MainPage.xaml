<Page x:Class="WPFMaster.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFMaster.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Width="40" Height="40" HorizontalAlignment="Left" Margin="10" Click="Button_Click" Background="Transparent" BorderBrush="Transparent" Focusable="False" Cursor="Hand">
            <Image Source="/Images/profile.png"/>
        </Button>
        <StackPanel>
            <TextBlock Text="Absolute Cinema" Height="40" Width="300" TextAlignment="Center" FontSize="30"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Сортировать по:" FontSize="10" Foreground="Gray" VerticalAlignment="Center" Margin="5"/>
                    <ComboBox x:Name="OrderComboBox" Width="100" SelectedIndex="0" SelectionChanged="ComboBox_SelectionChanged">
                        <ComboBoxItem Content="Название"/>
                        <ComboBoxItem Content="Рейтинг"/>
                    </ComboBox>
                </StackPanel>
                
                <TextBox x:Name="SearchBox" ToolTip="Поиск по названию" Width="300" TextChanged="SearchBox_TextChanged"/>
            </StackPanel>
        </StackPanel>
        
        
        <ListBox Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="FilmsListBox">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Height="250" Width="150">
                        <TextBlock TextAlignment="Center" Text="{Binding Name}"/>
                        <Image Height="200" Width="120" Source="{Binding ImagePath}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="5" Text="{Binding RateFilm}"/>
                            <TextBlock Margin="5" Text="{Binding RateAge.Age, StringFormat={}{0}+}"/>
                            <TextBlock Margin="5" Text="Сегодня"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
