<Page x:Class="WPFMaster.Pages.SignInPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFMaster.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SignInPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="1" Grid.Row="1">
            <TextBlock Text="Вход" HorizontalAlignment="Center" FontSize="30"/>
            <StackPanel Width="150">
                <StackPanel>
                    <TextBlock Text="Введите логин"/>
                    <TextBox x:Name="LoginBox" FontSize="10"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Введите пароль"/>
                    <TextBox x:Name="PasswordBox" FontSize="10"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Height="40">
                    <Button Content="Войти" Margin="5" Click="SignIn" Width="65" FontSize="10"/>
                    <Button Content="Регистрация" Margin="5" Click="RegistrationPage" Width="65" FontSize="10"/>
                </StackPanel>
            </StackPanel>
            
        </StackPanel>
    </Grid>
    
</Page>
