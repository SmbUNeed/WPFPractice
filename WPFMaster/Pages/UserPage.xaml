<Page x:Class="WPFMaster.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFMaster.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UserPage">

    <Grid>
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Grid.Row="1" Grid.Column="1">
                <TextBlock Text="Профиль" FontSize="20" TextAlignment="Center"/>
                <TextBlock x:Name="InfoBlock" Height="100"/>

                <TextBlock Text="Мои билеты" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,6"/>
                <ItemsControl x:Name="TicketsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Film}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Hall}"/>
                                    <TextBlock Text="{Binding DateTime}"/>
                                    <TextBlock Text="{Binding Seat}"/>
                                    <TextBlock Text="{Binding Price}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
