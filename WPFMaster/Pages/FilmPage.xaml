<Page x:Class="WPFMaster.Pages.FilmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFMaster.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FilmPage">

    <Grid>
        <ScrollViewer>
            <StackPanel>
                <StackPanel Orientation="Horizontal" >
                    <Image Source="{Binding ImagePath}" Width="350" Height="300"/>
                    <Viewbox Stretch="Uniform">
                        
                        <StackPanel Grid.Column="1" Margin="10">
                            <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding RateFilm, StringFormat=Рейтинг {0}}"/>
                            <TextBlock Text="{Binding RateAge.Age, StringFormat={}{0} +}"/>
                            <TextBlock Text="{Binding Description}" Height="300" Width="300" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Viewbox>
                </StackPanel>
                <ListBox x:Name="SessionListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SessionListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="2" BorderBrush="Black">
                                <StackPanel Width="120" Background="LightGray" >
                                    <TextBlock Text="{Binding Halls.Price, StringFormat={}{0} руб.}"/>
                                    <TextBlock Text="{Binding Halls.Name}"/>
                                    <TextBlock Text="{Binding Halls.PlaceQuantity, StringFormat={}Число мест: {0}}"/>
                                    <TextBlock Text="{Binding Halls.RateHall.Type}"/>
                                    <TextBlock Text="{Binding DateTime}"/>
                                    <TextBlock Text="{Binding Films.Name}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
        
    </Grid>
</Page>
